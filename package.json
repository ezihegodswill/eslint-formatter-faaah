{
  "name": "eslint-formatter-faaah",
  "version": "0.1.1",
  "description": "A custom ESLint formatter that plays a signature sound effect when errors or warnings exist.",
  "author": "Godswill Ezihe",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "eslint",
    "eslint-formatter",
    "formatter",
    "faaah",
    "audio",
    "sound"
  ],
  "scripts": {
    "build": "bun ./scripts/build.ts",
    "test": "bun test",
    "check-types": "tsc --noEmit",
    "prepare": "bun run build",
    "changeset": "changeset"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezihegodswill/eslint-formatter-faaah.git"
  },
  "bugs": {
    "url": "https://github.com/ezihegodswill/eslint-formatter-faaah/issues"
  },
  "homepage": "https://github.com/ezihegodswill/eslint-formatter-faaah#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ezihegodswill/native-audio-player": "^0.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/bun": "^1.3.14",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0"
  }
}
