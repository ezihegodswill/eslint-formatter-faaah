{
  "name": "@ezihegodswill/eslint-plugin-console-faaah",
  "version": "0.1.1",
  "author": "Godswill Ezihe",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/bun": "^1.3.14",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@typescript-eslint/utils": "^8.24.0",
    "eslint": "^9.20.0",
    "simple-git-hooks": "^2.9.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0"
  },
  "bin": {
    "console-faaah": "./dist/bin/console-faaah.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./formatters/faaah": {
      "import": "./dist/formatters/faaah.js",
      "require": "./dist/formatters/faaah.js",
      "types": "./dist/formatters/faaah.d.ts"
    }
  },
  "description": "An audio-interactive ESLint plugin and custom formatter that flags console statements and plays a signature 'faaah' sound effect on rule violations.",
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "console.log",
    "faaah",
    "audio",
    "dsp",
    "mediabunny"
  ],
  "license": "MIT",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/bin/console-faaah.ts --outdir ./dist --target node --format esm && chmod +x ./dist/bin/console-faaah.js && mkdir -p ./dist/assets && cp -R ./assets/* ./dist/assets/ && tsc --emitDeclarationOnly --outDir ./dist",
    "test": "bun test",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit -p tsconfig.test.json",
    "prepare": "simple-git-hooks",
    "changeset": "changeset"
  },
  "publishConfig": {
    "access": "public"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run check-types && bun test"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
